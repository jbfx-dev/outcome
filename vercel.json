{
  "functions": {
    "api/card.py": {
      "includeFiles": "api/_kit/**",
      "maxDuration": 60
    },
    "api/pd.js": {
      "includeFiles": "dashboards/pd/pd.js",
      "maxDuration": 20
    },
    "api/lb.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/dashboards/pd",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/dashboards/pd",
      "permanent": false
    },
    {
      "source": "/overall.html",
      "destination": "/dashboards/wc",
      "permanent": true
    },
    {
      "source": "/week-1.html",
      "destination": "/dashboards/wc/1",
      "permanent": true
    },
    {
      "source": "/week-2.html",
      "destination": "/dashboards/wc/2",
      "permanent": true
    },
    {
      "source": "/week-3.html",
      "destination": "/dashboards/wc/3",
      "permanent": true
    },
    {
      "source": "/week-4.html",
      "destination": "/dashboards/wc/4",
      "permanent": true
    },
    {
      "source": "/pd",
      "destination": "/dashboards/pd",
      "permanent": false
    },
    {
      "source": "/world-cup",
      "destination": "/dashboards/wc",
      "permanent": true
    },
    {
      "source": "/world-cup/:path(.*)",
      "destination": "/dashboards/wc/:path",
      "permanent": true
    },
    {
      "source": "/clicks-explorer",
      "destination": "/dashboards/wc/clicks-explorer",
      "permanent": true
    },
    {
      "source": "/clicks-explorer/:path(.*)",
      "destination": "/dashboards/wc/clicks-explorer/:path",
      "permanent": true
    },
    {
      "source": "/ugc-explorer",
      "destination": "/dashboards/wc/ugc-explorer",
      "permanent": true
    },
    {
      "source": "/ugc-explorer/:path(.*)",
      "destination": "/dashboards/wc/ugc-explorer/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/lb/:route",
      "destination": "/api/lb?_r=:route"
    },
    {
      "source": "/api/leaderboard",
      "destination": "/api/lb?_r=leaderboard"
    },
    {
      "source": "/api/trader",
      "destination": "/api/lb?_r=trader"
    },
    {
      "source": "/api/positions",
      "destination": "/api/lb?_r=positions"
    },
    {
      "source": "/api/position",
      "destination": "/api/lb?_r=position"
    },
    {
      "source": "/api/resolve",
      "destination": "/api/lb?_r=resolve"
    },
    {
      "source": "/api/top-trades",
      "destination": "/api/lb?_r=top-trades"
    },
    {
      "source": "/api/diag",
      "destination": "/api/lb?_r=diag"
    },
    {
      "source": "/api/pd/:route",
      "destination": "/api/pd?_r=:route"
    },
    {
      "source": "/leaderboard/trades",
      "destination": "/leaderboard/index.html"
    },
    {
      "source": "/leaderboard/t/:username",
      "destination": "/leaderboard/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    }
  ]
}
